DATABASE_URL=postgresql+psycopg://industrial_ai:industrial_ai@localhost:5432/industrial_ai
CORS_ORIGINS=["*"]

# Reserved for future hosted-model integrations. These values are not currently used.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Active local RAG settings.
# "fake" works with the base install and creates deterministic, non-semantic vectors.
# "local" uses sentence-transformers and requires: pip install sentence-transformers
RAG_EMBEDDING_PROVIDER=fake
LOCAL_EMBEDDING_MODEL=intfloat/multilingual-e5-small
LOCAL_EMBEDDING_BATCH_SIZE=32
